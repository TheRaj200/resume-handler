# Copy to .env and fill values. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (M0 free tier is fine).
# Whitelist 0.0.0.0/0 for Render, or your current IP for local dev.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobpilot?retryWrites=true&w=majority

# Comma-separated origins, or * for development.
CORS_ORIGIN=*

# 32+ random chars. Used for JWT signing (Phase 4).
JWT_SECRET=replace-with-a-long-random-secret
